{
  "id": null,
  "uid": "obskit-overview",
  "title": "obskit - Service Overview",
  "tags": [
    "obskit",
    "observability"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "hide": 0,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "definition": "label_values(service_name)",
        "query": {
          "query": "label_values(service_name)",
          "refId": "StandardVariableQuery"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "regex": ""
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "definition": "label_values(lab_request_duration_seconds_count, lab_route)",
        "includeAll": true,
        "label": "route",
        "multi": true,
        "name": "route",
        "options": [],
        "query": {
          "query": "label_values(lab_request_duration_seconds_count, lab_route)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requests (lab.request.duration)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Requests per second from lab.request.duration _count, per service.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service_name, lab_route) (rate(lab_request_duration_seconds_count{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{lab_route}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency",
      "description": "avg is EXACT (rate of _sum / rate of _count). p50/p95/p99 are bucket-limited: obskit's duration histograms use the OTel default ms-scale buckets (le=5,10,25,...) while recording SECONDS, so percentiles are coarse and sub-5s work collapses into the first bucket. See grafana/README.md.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le, lab_route) (rate(lab_request_duration_seconds_bucket{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50 {{lab_route}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, lab_route) (rate(lab_request_duration_seconds_bucket{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p95 {{lab_route}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, lab_route) (rate(lab_request_duration_seconds_bucket{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p99 {{lab_route}}",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (lab_route) (rate(lab_request_duration_seconds_sum{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval])) / sum by (lab_route) (rate(lab_request_duration_seconds_count{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "avg {{lab_route}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests by outcome (ok / degraded / error)",
      "description": "lab.outcome is bounded to ok|degraded|error. Degraded requests succeed and are NOT counted as errors (see error-rate panel).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (lab_outcome, lab_route) (rate(lab_request_duration_seconds_count{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{lab_route}} {{lab_outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error & degraded rate",
      "description": "or vector(0) shows 0% when traffic exists but no error/degraded turns (correct-empty, shown as zero). No traffic at all => No data (nothing happened). A broken query would error instead - distinguishable.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (sum by (lab_route) (rate(lab_request_duration_seconds_count{service_name=~\"$service\",lab_route=~\"$route\",lab_outcome=\"error\"}[$__rate_interval])) or (0 * sum by (lab_route) (rate(lab_request_duration_seconds_count{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval])))) / sum by (lab_route) (rate(lab_request_duration_seconds_count{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "error % {{lab_route}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (sum by (lab_route) (rate(lab_request_duration_seconds_count{service_name=~\"$service\",lab_route=~\"$route\",lab_outcome=\"degraded\"}[$__rate_interval])) or (0 * sum by (lab_route) (rate(lab_request_duration_seconds_count{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval])))) / sum by (lab_route) (rate(lab_request_duration_seconds_count{service_name=~\"$service\",lab_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "degraded % {{lab_route}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Retrieval (lab.retrieval.duration)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Retrieval rate",
      "description": "Retrieval operations per second. Fires on every retrieving turn, even when zero chunks are returned.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service_name) (rate(lab_retrieval_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retrieval latency",
      "description": "avg is EXACT. Retrieval is typically sub-second, so ALL of it lands in the first histogram bucket (le=5s) and p50/p95 read as bucket artifacts (~4.75s), not real latency - use avg. See grafana/README.md.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(lab_retrieval_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lab_retrieval_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (rate(lab_retrieval_duration_seconds_sum{service_name=~\"$service\"}[$__rate_interval])) / sum (rate(lab_retrieval_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "avg",
          "range": true
        }
      ]
    }
  ]
}
